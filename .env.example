# Copy this file to .env.local and fill in real values. Never commit real secrets.

# Postgres connection used by the app at runtime (e.g. pooled connection string).
DATABASE_URL=

# Direct (non-pooled) Postgres connection used for migrations.
DATABASE_DIRECT_URL=

# Spotify API app credentials (developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Long-lived Spotify refresh token for the owner account used to read/write playlists.
SPOTIFY_REFRESH_TOKEN=

# Secret used to sign/encrypt session cookies.
SESSION_SECRET=

# Spotify user ID of the app owner (used to gate dev/admin routes).
OWNER_SPOTIFY_USER_ID=

# Public origin of the deployed app (e.g. https://example.com).
NEXT_PUBLIC_HOST=

# Shared secret required by cron-triggered API routes.
CRON_SECRET=

# Anthropic API key — used for vibe tagging and the LLM set director.
ANTHROPIC_API_KEY=

# Last.fm API key — used for the discovery lane.
LASTFM_API_KEY=

# GetSongBPM API key — used for bpm/key enrichment. Register at getsongbpm.com/api
# (attribution link to GetSongBPM is required on the site per their terms).
GETSONGBPM_API_KEY=
